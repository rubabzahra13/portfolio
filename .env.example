# Production site URL (required for SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Google Search Console verification (HTML tag value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Social profiles (used in Organization schema sameAs)
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# Optional Twitter @handle for cards
NEXT_PUBLIC_TWITTER_HANDLE=
